# Docker kurulumu için ayarlar (docker-compose.yml okur). Bu dosyayı ".env" olarak kopyala ya da
# kurulum.ps1 / kurulum.sh çalıştır: gizli anahtarları otomatik üretip .env'i senin için oluşturur.
# Yerel geliştirmenin ayarları ayrıdır: apps/web/.env (örnek: apps/web/.env.example).

# Veritabanı şifresi (yalnızca konteynerler arasında kullanılır)
POSTGRES_PASSWORD=degistir-uzun-rastgele-bir-sifre

# Oturum imzası için en az 32 karakter rastgele metin. Değişirse herkesin oturumu kapanır.
AUTH_SECRET=degistir-en-az-32-karakterlik-rastgele-bir-metin

# Zamanlanmış görev uçları için (isteğe bağlı)
CRON_SECRET=

# Uygulamanın dışarıdan açıldığı adres (e-postalardaki bağlantılar için)
APP_URL=http://localhost:3000
APP_PORT=3000

# İlk kurulumda oluşturulacak Admin hesabı (kullanıcı yoksa). Şifre en az 8 karakter, harf + rakam.
# Admin ilk girişte şifresini değiştirmek zorundadır.
SEED_ADMIN_NAME=Yönetici
SEED_ADMIN_EMAIL=admin@ajansiniz.com
SEED_ADMIN_PASSWORD=degistir-Ilk-Sifre-2026

# E-posta (isteğe bağlı). Boşsa e-postalar gönderilmez, Ayarlar → Bildirimler ve E-posta'da görünür.
SMTP_URL=
EMAIL_FROM=

# Dosya ekleri: varsayılan konteyner diski (kalıcı volume). Bulut için STORAGE_DRIVER=s3 ve S3_* ayarları (apps/web/.env.example).
STORAGE_DRIVER=local

# Hata bildirimi için Slack/Discord webhook (isteğe bağlı)
ERROR_WEBHOOK_URL=
