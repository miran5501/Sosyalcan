{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/check-env.ts",
    "build": "prisma generate && next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "node scripts/test-db.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "smoke": "node scripts/smoke-web.mjs",
    "security": "node scripts/security-check.mjs",
    "seed": "tsx prisma/seed.ts",
    "db:backup": "node scripts/backup-db.mjs",
    "db:restore-test": "node scripts/restore-db.mjs",
    "storage:check": "tsx scripts/check-storage.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "next": "^16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^10.0.13",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "^9.3.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1",
    "write-excel-file": "^4.1.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  }
}
